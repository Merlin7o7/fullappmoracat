# ════════════════════════════════════════════════════════════════════════
#  Moracat — PRODUCTION env template
#  Copy to `.env` on your server:  cp .env.production.example .env
#  Then fill every value marked <…>. NEVER commit the real .env.
# ════════════════════════════════════════════════════════════════════════

NODE_ENV=production

# ─── Your domain (used by Caddy + the web build) ─────────────────────────
# The public site and the API subdomain.
SITE_DOMAIN=moracat.co
API_DOMAIN=api.moracat.co
# Full URLs (https). These are baked into the web build + API CORS.
SITE_URL=https://moracat.co
API_URL=https://api.moracat.co

# The web app reads these at BUILD time (Vercel env / docker build args):
NEXT_PUBLIC_SITE_URL=https://moracat.co
NEXT_PUBLIC_API_BASE_URL=https://api.moracat.co
# Permanent public locator encoded in each cat's QR:
NEXT_PUBLIC_CAT_ID_BASE=https://moracat.co/c

# ─── Database (managed Postgres or the bundled postgres service) ──────────
# If you use the bundled postgres container, set POSTGRES_PASSWORD and the
# api service builds DATABASE_URL for you. For a managed DB (Neon/Supabase),
# set DATABASE_URL directly and drop the postgres service.
POSTGRES_USER=moraqat
POSTGRES_PASSWORD=<generate: openssl rand -base64 24>
POSTGRES_DB=moraqat
# DATABASE_URL=postgresql://user:pass@host:5432/db?schema=public&sslmode=require

REDIS_URL=redis://redis:6379

# ─── Auth secrets — generate each with: openssl rand -base64 48 ──────────
JWT_ACCESS_SECRET=<generate>
JWT_REFRESH_SECRET=<generate>
# Must be distinct from the two above; boot validation enforces it.
JWT_COUNTER_SECRET=<generate>
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
JWT_REMEMBER_TTL=5184000
OTP_TTL_SECONDS=300

# ─── Continue with Google (optional but recommended) ─────────────────────
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com →
# Authorized JS origins: https://example.com   Redirect: not needed (GIS).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ─── SMS OTP delivery (Twilio) ────────────────────────────────────────────
# Set all three to send real OTP codes. Also set NEXT_PUBLIC_SMS_ENABLED=true
# on the web (Vercel) to show the OTP steps.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Campaign analytics (web / Vercel) ───────────────────────────────────
# Consent-gated; each provider dark until its id is set AND the visitor accepts.
# No PII is ever sent. Snapchat is a first-class KSA channel — don't skip it.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_SNAPCHAT_PIXEL_ID=
NEXT_PUBLIC_CLARITY_ID=

# ─── Census integrity / bot protection ───────────────────────────────────
# Turnstile: secret on the API (Render), site key on the web (Vercel). Both
# unset = transparent no-op. Turn on together to enforce proof-of-humanity.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Optional tuning (safe defaults in code): 8 cats/account/day, alert at 5
# accounts/IP/day and 12 registrations/IP/hour.
# CENSUS_MAX_CATS_PER_DAY=8
# CENSUS_IP_ACCOUNTS_ALERT=5
# CENSUS_IP_REGS_PER_HOUR_ALERT=12
SECURITY_SALT=<generate>

# ─── Payments (leave mock until you have live keys) ──────────────────────
PAYMENTS_MODE=mock
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
TABBY_API_KEY=
TABBY_WEBHOOK_SECRET=
TAMARA_API_TOKEN=
TAMARA_NOTIFICATION_TOKEN=
MOCK_WEBHOOK_SECRET=<generate>
