# ═══════════════════════════════════════════════════════════════════════
#  Moracat — environment reference
#
#  Every variable here is READ by the code (apps/api, apps/web, seeds). If a
#  variable isn't here, nothing reads it. Production values live in the Render
#  (API) and Vercel (web) dashboards — never in the repo. See DEPLOY.md.
# ═══════════════════════════════════════════════════════════════════════

# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development
# API listen port (Render injects PORT; API_PORT is a legacy alias).
PORT=4000

# ─── Community Mode (monetization kill-switch) ──────────────────────────
# Default OFF → no checkout, no paid subscriptions, no payment surface is
# reachable (fail-closed). Flip to true ONLY when payments go live — the API
# refuses to boot in prod if COMMERCE_ENABLED=true without PAYMENTS_MODE=live.
COMMERCE_ENABLED=false
# The web mirror of the same switch (hides commercial surfaces client-side).
NEXT_PUBLIC_COMMERCE_ENABLED=false
# Phone/SMS sign-in surfaces on the web (the API still needs Twilio below).
NEXT_PUBLIC_SMS_ENABLED=false

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Local: `pnpm db:local` (embedded Postgres). Prod: Neon pooled URL.
DATABASE_URL="postgresql://moraqat:moraqat_dev_pw@localhost:5432/moraqat?schema=public"
# DIRECT_DATABASE_URL — set on Render for `prisma migrate deploy` (pgbouncer cannot run migrations).
# DIRECT_DATABASE_URL=""

# ─── URLs ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Commercial Registration / VAT numbers shown in the site footer. Leave empty to
# hide the line — they are never defaulted or guessed (digits only).
NEXT_PUBLIC_CR_NUMBER=""
NEXT_PUBLIC_VAT_NUMBER=""
# The API's own public origin, used in links it mints (signed file links,
# certificate PDFs). Falls back to NEXT_PUBLIC_API_BASE_URL.
API_PUBLIC_URL=""
# Same, as the Tamara adapter needs it for its notification URL.
API_BASE_URL="http://localhost:4000"
# Extra CORS origins (comma-separated) beyond NEXT_PUBLIC_SITE_URL.
CORS_ORIGINS=""
# Swagger is on outside production; set "true" to expose /api/docs in prod.
ENABLE_SWAGGER=false
# Global rate limit per minute per IP (default 120). Strict auth routes use max(8, this).
THROTTLE_LIMIT=120
# Next standalone output (Docker). Leave unset on Windows dev boxes (no symlinks).
NEXT_STANDALONE=

# ─── Auth (JWT) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Vet counter-mode PIN tokens. MUST be distinct from the two above — a shared
# secret would let a 4-digit PIN mint a full member access token.
JWT_COUNTER_SECRET="change-me-counter-secret"
JWT_ACCESS_TTL="900"          # 15 minutes (seconds)
JWT_REFRESH_TTL="1209600"     # 14 days (seconds)
JWT_REMEMBER_TTL="5184000"    # "remember me" refresh lifetime, 60 days (seconds)
OTP_TTL_SECONDS="300"         # email / phone OTP validity
# Google sign-in: the OAuth client id (API verifies the audience; web renders the button).
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# ─── Payment providers ───────────────────────────────────────────────────
# PAYMENTS_MODE=mock → in-repo sandbox for everything (default).
# PAYMENTS_MODE=live → per-provider adapters; any provider missing credentials
#                      falls back to mock (logged). Card rails (mada/Visa/MC/
#                      Apple Pay) run through Moyasar's embedded form; Tamara
#                      through its hosted page.
PAYMENTS_MODE="mock"

# Moyasar (https://moyasar.com) — use sk_test_* / pk_test_* keys for sandbox.
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""
# Publishable key for the embedded card form (mada / Visa / Mastercard / Apple
# Pay). The browser tokenises cards straight into Moyasar with it; the server
# confirms every payment by reading it back with the secret key. Required in
# live mode alongside the secret key.
MOYASAR_PUBLISHABLE_KEY=""
# MOYASAR_BASE_URL="https://api.moyasar.com/v1"

# Tabby (https://tabby.ai)
TABBY_API_KEY=""
TABBY_MERCHANT_CODE="moraqat_sa"
TABBY_WEBHOOK_SECRET=""
# TABBY_BASE_URL="https://api.tabby.ai/api/v2"

# Tamara (https://tamara.co) — defaults to the sandbox host.
TAMARA_API_TOKEN=""
TAMARA_NOTIFICATION_TOKEN=""
# TAMARA_BASE_URL="https://api-sandbox.tamara.co"

# Mock webhook secret (dev only; ignored in live mode).
MOCK_WEBHOOK_SECRET="mock-webhook-secret"

# ─── Pricing & launch ────────────────────────────────────────────────────
# VAT applied to memberships (0 until VAT-registered; then 0.15).
VAT_RATE="0"
# Shortest committed term a member may buy (months).
MIN_TERM_MONTHS="1"
# Founding-member first-delivery date shown before launch (YYYY-MM-DD).
LAUNCH_FIRST_DELIVERY="2026-09-01"
NEXT_PUBLIC_LAUNCH_FIRST_DELIVERY="2026-09-01"

# ─── SMS (Twilio REST — OTPs, claim links, found-cat relays) ───────────
# Leave blank locally: messages are logged instead of sent.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
# Clinic-created patients (MRC-PROD-001 T4): the claim link is shown on the
# counter screen always; SMS delivery only when this is "true". Phone numbers
# on claim invites are hashed with CLAIM_HASH_SALT (required in production).
CLAIM_SMS_ENABLED=false
CLAIM_HASH_SALT="change-me-claim-hash-salt"
# "I found this cat" (T6): the owner always gets in-app + email; SMS too when true.
FOUND_SMS_ENABLED=false

# ─── Transactional email (Resend) ──────────────────────────────────────
# EMAIL_PROVIDER=resend + a key → real sends. Otherwise dev "log" mode prints
# emails (and action links) to the server log — no credentials needed locally.
EMAIL_PROVIDER="log"           # "resend" | "log"
RESEND_API_KEY=""              # re_… (set in the deploy dashboard, never commit)
# Until your domain is verified in Resend, test mode only sends to your own
# Resend account email. After verifying moracat.co, use your domain here.
EMAIL_FROM="Moracat <onboarding@resend.dev>"
# Where new clinic applications are announced (empty = no notification email).
PARTNERS_NOTIFY_EMAIL=""

# ─── Storage (Cloudflare R2 — S3-compatible) ────────────────────────────
# Leave blank locally to use the dev fallback (writes to ./.uploads, served at
# /uploads; private objects go to ./.private-uploads). Set all for production R2.
# Endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="moracat-media"
S3_ACCESS_KEY=""              # R2 API token — Access Key ID
S3_SECRET_KEY=""              # R2 API token — Secret Access Key
# Public base URL objects are served from (R2 public bucket URL or custom domain
# e.g. https://cdn.moracat.co). Required so uploaded images are publicly viewable.
S3_PUBLIC_URL=""
# Separate bucket for PRIVATE objects (clinic documents, medical attachments,
# certificates). Empty = same bucket, unguessable keys under private/.
S3_PRIVATE_BUCKET=""

# ─── Partner verification ───────────────────────────────────────────────
# Shared key partner tools send to verify a Cat ID (GET /verify with x-partner-key).
PARTNER_VERIFY_KEY=""

# ─── Wallet passes (R034) ───────────────────────────────────────────────
# Fail-closed: leave blank and the feature reports unavailable — the web
# shows no wallet buttons. Google Wallet: create an Issuer account + a
# service account with the Wallet Object Issuer role, then set all three.
# Key is the service-account private key PEM ("\n" escapes are normalized).
WALLET_GOOGLE_ISSUER_ID=""
WALLET_GOOGLE_SA_EMAIL=""
WALLET_GOOGLE_SA_KEY=""
# Apple Wallet ships once the Pass Type ID certificate chain exists
# (needs the Apple Developer account; envs will be WALLET_APPLE_*).

# ─── Observability ──────────────────────────────────────────────────────
# Error tracking (no-op when empty). SENTRY_DSN → API + web server/edge;
# NEXT_PUBLIC_SENTRY_DSN → web browser. SENTRY_TRACES_SAMPLE_RATE default 0.1.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Log verbosity for the API's structured (pino) logs: debug|info|warn|error.
LOG_LEVEL="info"
# Scheduled-job heartbeats (MRC-PROD-001 T1). Each cron pings its URL after a
# successful run and <url>/fail after a failed one (Healthchecks.io style). A
# missed ping is how you learn the dyno slept through a tick. Empty = no ping.
HEARTBEAT_URL_LIFECYCLE=""
HEARTBEAT_URL_VET_COMPLIANCE=""
HEARTBEAT_URL_METRICS=""

# ─── Seeds & one-off scripts (dev / operator only) ──────────────────────
# The seed creates a super-admin ONLY outside production, OR in production when
# ADMIN_SEED_PASSWORD is set (≥12 chars). Leave empty in prod unless bootstrapping.
ADMIN_SEED_EMAIL="admin@moraqat.sa"
ADMIN_SEED_PASSWORD=""
# seed-catalog: fallback retail markup over wholesale when a SKU has no market price.
CATALOG_MARKUP="2.0"
# seed-catalog refuses plans whose COGS beat their price unless this is "1".
ALLOW_UNPROFITABLE_PLANS=""
# seed-vet-demo refuses to run against a DB that already holds real clinical data unless "1".
ALLOW_DEMO_ON_REAL_DATA=""
# seed-community: the founder account that "likes" the first public cats.
FOUNDER_EMAIL=""
# backfill scripts: "1" prints what would change without writing.
DRY_RUN=""
