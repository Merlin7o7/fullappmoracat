# ─── Core ───────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── Community Mode (monetization kill-switch) ──────────────────────────
# Default OFF → no checkout, no paid subscriptions, no payment surface is
# reachable (fail-closed). Flip to true ONLY when payments go live — the API
# refuses to boot in prod if COMMERCE_ENABLED=true without PAYMENTS_MODE=live.
COMMERCE_ENABLED=false

# ─── Database (PostgreSQL) ──────────────────────────────────────────────
# Matches docker-compose.yml service credentials
DATABASE_URL="postgresql://moraqat:moraqat_dev_pw@localhost:5432/moraqat?schema=public"

# ─── Redis (cache, rate-limit, queues) ──────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── API ────────────────────────────────────────────────────────────────
API_PORT=4000
API_BASE_URL="http://localhost:4000"

# ─── Web ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"

# ─── Auth (JWT / NextAuth) ──────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
# Vet counter-mode PIN tokens. MUST be distinct from the two above — a shared
# secret would let a 4-digit PIN mint a full member access token.
JWT_COUNTER_SECRET="change-me-counter-secret"
JWT_ACCESS_TTL="900"          # 15 minutes (seconds)
JWT_REFRESH_TTL="1209600"     # 14 days (seconds)
NEXTAUTH_SECRET="change-me-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Payment providers ───────────────────────────────────────────────────
# PAYMENTS_MODE=mock → in-repo sandbox for everything (default).
# PAYMENTS_MODE=live → per-provider adapters; any provider missing credentials
#                      falls back to mock (logged). Card rails (Mada/Visa/MC/
#                      Apple Pay/STC Pay) run through Moyasar.
PAYMENTS_MODE="mock"

# Moyasar (https://moyasar.com) — use sk_test_* keys for sandbox.
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""
# MOYASAR_BASE_URL="https://api.moyasar.com/v1"

# Tabby (https://tabby.ai)
TABBY_API_KEY=""
TABBY_MERCHANT_CODE="moraqat_sa"
TABBY_WEBHOOK_SECRET=""
# TABBY_BASE_URL="https://api.tabby.ai/api/v2"

# Tamara (https://tamara.co) — defaults to the sandbox host.
TAMARA_API_TOKEN=""
TAMARA_NOTIFICATION_TOKEN=""
# TAMARA_BASE_URL="https://api-sandbox.tamara.co"

# Mock webhook secret (dev only; ignored in live mode).
MOCK_WEBHOOK_SECRET="mock-webhook-secret"

# ─── Notifications (MOCK MODE for dev) ──────────────────────────────────
NOTIFICATIONS_MODE="mock"
SMS_PROVIDER_KEY=""
WHATSAPP_TOKEN=""
SMTP_URL=""

# ─── Transactional email (Resend) ──────────────────────────────────────
# EMAIL_PROVIDER=resend + a key → real sends. Otherwise dev "log" mode prints
# emails (and action links) to the server log — no credentials needed locally.
EMAIL_PROVIDER="log"           # "resend" | "log"
RESEND_API_KEY=""              # re_… (set in the deploy dashboard, never commit)
# Until your domain is verified in Resend, test mode only sends to your own
# Resend account email. After verifying moracat.co, use your domain here.
EMAIL_FROM="Moracat <onboarding@resend.dev>"

# ─── Storage (Cloudflare R2 — S3-compatible) ────────────────────────────
# Leave blank locally to use the dev fallback (writes to ./.uploads, served at
# /uploads). Set all four (+ public URL) for production R2.
# Endpoint: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="moracat-media"
S3_ACCESS_KEY=""              # R2 API token — Access Key ID
S3_SECRET_KEY=""              # R2 API token — Secret Access Key
# Public base URL objects are served from (R2 public bucket URL or custom domain
# e.g. https://cdn.moracat.co). Required so uploaded images are publicly viewable.
S3_PUBLIC_URL=""

# ─── Wallet passes (R034) ───────────────────────────────────────────────
# Fail-closed: leave blank and the feature reports unavailable — the web
# shows no wallet buttons. Google Wallet: create an Issuer account + a
# service account with the Wallet Object Issuer role, then set all three.
# Key is the service-account private key PEM ("\n" escapes are normalized).
WALLET_GOOGLE_ISSUER_ID=""
WALLET_GOOGLE_SA_EMAIL=""
WALLET_GOOGLE_SA_KEY=""
# Apple Wallet ships once the Pass Type ID certificate chain exists
# (needs the Apple Developer account; envs will be WALLET_APPLE_*).

# ─── Observability ──────────────────────────────────────────────────────
# Error tracking (no-op when empty). SENTRY_DSN → API + web server/edge;
# NEXT_PUBLIC_SENTRY_DSN → web browser. SENTRY_TRACES_SAMPLE_RATE default 0.1.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
# Log verbosity for the API's structured (pino) logs: debug|info|warn|error.
LOG_LEVEL="info"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.posthog.com"

# ─── Admin bootstrap ────────────────────────────────────────────────────
# The seed creates a super-admin ONLY outside production, OR in production when
# ADMIN_SEED_PASSWORD is set (≥12 chars). Leave empty in prod unless bootstrapping.
ADMIN_SEED_EMAIL="admin@moraqat.sa"
ADMIN_SEED_PASSWORD=""
