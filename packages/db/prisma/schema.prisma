/// Idempotency ledger for the lifecycle engine (term-end invitations, graceful
/// lapse, vaccination reminders, birthdays/anniversaries, draft expiry). One
/// row per (event, subject, occurrence) — the unique `key` guarantees a restart
/// or concurrent worker can never double-send. Doubles as the "reminders
/// honoured" ledger the dashboard counts (R049): every row is a promise kept.
model LifecycleEvent {
  id        String   @id @default(cuid())
  key       String   @unique
  type      String // term_end_t7 | term_end_t1 | membership_lapsed | vacc_t7 | vacc_t1 | draft_expired | cat_birthday | member_anniversary
  userId    String?
  catId     String?
  subjectId String? // subscriptionId / vaccinationId — the concrete subject
  createdAt DateTime @default(now())

  @@index([userId, type])
  @@index([catId, type])
  @@map("lifecycle_events")
}

