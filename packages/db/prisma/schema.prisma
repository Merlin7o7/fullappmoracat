// ════════════════════════════════════════════════════════════════════════
//  Moraqat (مرقط) — Enterprise Database Schema
//  Saudi cat-essentials subscription platform. All money in SAR.
//  Prisma + PostgreSQL. IDs are cuid(). Soft-deletes via `deletedAt`.
// ════════════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum Locale {
  ar
  en
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DEACTIVATED
}

enum StaffScope {
  SUPER_ADMIN
  OWNER
  MANAGER
  WAREHOUSE
  FINANCE
  MARKETING
  SUPPORT
  CONTENT
  DELIVERY
  ANALYST
}

enum CatGender {
  MALE
  FEMALE
  UNKNOWN
}

/// Account-owner gender — drives the warm Najdi greeting (يبو / أم) (R001, R087).
enum Gender {
  MALE
  FEMALE
  UNSPECIFIED
}

/// Lifecycle of a cat within a household. Removal is soft (deletedAt); a
/// deceased cat is *archived with dignity*, never deleted — the record and the
/// Cat ID are kept forever (R010 "leaving is easy", P09 "the cat is the hero").
enum CatStatus {
  ACTIVE
  ARCHIVED
  DECEASED
}

/// Per-cat membership standing. Each cat carries its own identity and benefits,
/// so membership is tracked per cat, not only per account.
enum CatMembershipStatus {
  ACTIVE
  INACTIVE
  PENDING
}

/// One-time-passcode purposes (SMS). Kept coarse; the code itself is hashed.
enum OtpPurpose {
  REGISTER
  LOGIN
  VERIFY_PHONE
}

enum ActivityLevel {
  LOW
  MODERATE
  HIGH
}

enum LifeStage {
  KITTEN
  ADULT
  SENIOR
}

enum PlanTier {
  // Current official tiers (2026-07). STARTER/STANDARD/PREMIUM are the live plans.
  STARTER
  STANDARD
  PREMIUM
  // Legacy tiers — retained so pre-existing plan rows/subscriptions stay valid.
  // Deactivated (isActive=false); never offered to new subscribers. Do not reuse.
  ESSENTIAL
  COMPLETE_CARE
  MULTI_CAT
}

enum BillingInterval {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  CUSTOM
}

enum SubscriptionStatus {
  DRAFT
  ACTIVE
  PAUSED
  CANCELLED
  PAST_DUE
  EXPIRED
}

enum ProductType {
  DRY_FOOD
  WET_FOOD
  TREATS
  LITTER
  SHAMPOO
  ACCESSORY
  TOY
  BED
  BOWL
  CARRIER
  SCRATCHING_POST
  HEALTHCARE
  VITAMIN
  SUPPLEMENT
  GROOMING
  OTHER
}

/// Whether a catalog product can be fulfilled today (imported supplier stock)
/// or is a popular option we advertise as choosable but must still procure.
/// Box-builder options show IN_STOCK first; TO_SOURCE is labelled honestly.
enum SourcingStatus {
  IN_STOCK
  TO_SOURCE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
  FAILED
}

enum OrderSource {
  SUBSCRIPTION
  ONE_TIME
  GIFT
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  VOIDED
}

enum PaymentProvider {
  MADA
  VISA
  MASTERCARD
  APPLE_PAY
  GOOGLE_PAY
  STC_PAY
  TABBY
  TAMARA
  WALLET
  GIFT_CARD
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  VOID
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

enum WalletTxnType {
  CREDIT
  DEBIT
  REFUND
  REWARD
  REFERRAL
  ADJUSTMENT
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  PUSH
  IN_APP
}

enum NotificationCategory {
  ORDER
  BILLING
  PROMOTION
  SUBSCRIPTION
  DELIVERY
  COMMUNITY
  SYSTEM
}

enum ShipmentStatus {
  LABEL_CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RETURNED
}

enum StockMovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  RETURN
  DAMAGE
  EXPIRY
}

enum PurchaseOrderStatus {
  DRAFT
  SUBMITTED
  APPROVED
  RECEIVED
  CANCELLED
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

// ─────────────────────────────────────────────────────────────────────────
//  IDENTITY & ACCESS
// ─────────────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(cuid())
  /// Permanent, immutable, human-readable Member ID (e.g. MRC-M-7Q4K2P). Issued
  /// once at signup, never reused or changed — the customer's identity number.
  memberIdNumber String?   @unique
  email         String     @unique
  phone         String?    @unique
  passwordHash  String?
  firstName     String?
  lastName      String?
  avatarUrl     String?
  /// Optional public-facing handle shown on shared Cat IDs when the owner opts
  /// to reveal a name — never the legal name unless they choose it.
  ownerNickname String?
  /// Master switch for the owner's own community presence (separate from each
  /// cat's visibility). Private by default — sharing is always opt-in.
  profileIsPublic Boolean  @default(false)
  gender        Gender     @default(UNSPECIFIED)
  /// Dial code, defaulting to Saudi Arabia (+966). `phone` is stored in full
  /// E.164 form; this records the chosen country for a frictionless re-entry.
  dialCode      String     @default("+966")
  locale        Locale     @default(ar)
  status        UserStatus @default(PENDING)
  emailVerified DateTime?
  phoneVerified DateTime?
  /// The chosen "face" of the household — powers the greeting, the featured
  /// Cat ID, quick actions and default context (multi-cat requirement).
  primaryCatId  String?    @unique
  termsAcceptedAt DateTime?
  isStaff       Boolean    @default(false)
  /// Set the first time this member is shown the post-first-Cat-ID welcome
  /// (Stage 4 ceremony hand-off). Null = never onboarded yet, so the very next
  /// Cat ID issuance routes them to /portal/welcome exactly once.
  onboardedAt   DateTime?
  /// Referral: this member's own shareable code, and the code that referred them
  /// (captured from ?ref= at signup). Powers the invite loop + "invited N friends".
  referralCode   String?   @unique
  referredByCode String?
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?

  // Auth relations
  accounts           OAuthAccount[]
  sessions           DeviceSession[]
  twoFactor          TwoFactor?
  loginHistory       LoginHistory[]
  passwordResets     PasswordReset[]
  emailVerifications EmailVerification[]
  roleAssignments    UserRole[]
  auditLogs          AuditLog[]

  // Domain relations
  cats           Cat[]
  primaryCat     Cat?                     @relation("PrimaryCat", fields: [primaryCatId], references: [id])
  addresses      Address[]
  paymentMethods PaymentMethod[]
  subscriptions  Subscription[]
  orders         Order[]
  invoices       Invoice[]
  carts          Cart[]
  wallet         Wallet?
  loyalty        LoyaltyAccount?
  reviews        ProductReview[]
  questions      ProductQuestion[]
  wishlist       WishlistItem[]
  recentlyViewed RecentlyViewed[]
  catLikes       CatLike[]
  reportsMade      CatReport[] @relation("CatReportReporter")
  reportsResolved  CatReport[] @relation("CatReportResolver")
  notifications  Notification[]
  notifPrefs     NotificationPreference[]
  tickets        SupportTicket[]
  ticketMessages TicketMessage[]
  returns        ReturnRequest[]
  referralsMade  Referral[]               @relation("Referrer")
  referredBy     Referral?                @relation("Referred")
  badges         UserBadge[]
  // ── Veterinary platform (MRC-VET-001) ──────────────────────────────────
  partnerStaff       PartnerStaff[]
  consentsGranted    ConsentGrant[]      @relation("ConsentGrantedBy")
  consentsRevoked    ConsentGrant[]      @relation("ConsentRevokedBy")
  registeredDevices  CounterDevice[]     @relation("DeviceRegisteredBy")
  partnerInvitesSent PartnerInvite[]     @relation("PartnerInviteSender")

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // google, apple, ...
  providerAccountId String
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  expiresAt         Int?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

model TwoFactor {
  id          String    @id @default(cuid())
  userId      String    @unique
  secret      String
  enabled     Boolean   @default(false)
  backupCodes String[]
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor")
}

model DeviceSession {
  id           String    @id @default(cuid())
  userId       String
  refreshHash  String    @unique
  userAgent    String?
  ipAddress    String?
  deviceLabel  String?
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_sessions")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  ipAddress String?
  userAgent String?
  city      String?
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("login_history")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

/// Email confirmation + email-change challenge. The token is hashed, single-use
/// and short-lived. `purpose` is VERIFY_EMAIL (confirm the address at/after
/// signup) or CHANGE_EMAIL (verify a requested new address in `newEmail` before
/// it replaces the account email).
/// Email verification challenge. For signup this holds a 6-digit OTP (hashed in
/// `codeHash`), single-use, short-lived and attempt-limited. `purpose` is
/// VERIFY_EMAIL (confirm the address) or CHANGE_EMAIL (verify a new address in
/// `newEmail`). `attempts` caps guesses; the row is invalidated once exceeded.
model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  purpose   String    @default("VERIFY_EMAIL")
  newEmail  String?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("email_verifications")
}

/// SMS one-time-passcode challenge. The code is hashed; challenges are
/// single-use, short-lived, and attempt-limited. Supports both passwordless
/// login and phone verification during registration.
model OtpChallenge {
  id          String     @id @default(cuid())
  phone       String
  purpose     OtpPurpose
  codeHash    String
  attempts    Int        @default(0)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  @@index([phone, purpose])
  @@index([expiresAt])
  @@map("otp_challenges")
}

model Role {
  id          String      @id @default(cuid())
  key         String      @unique // super_admin, manager, custom-...
  name        String
  description String?
  scope       StaffScope?
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "orders.read", "products.write"
  resource    String
  action      String
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // "order.refund", "product.update"
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
//  CUSTOMER PROFILE — addresses, payment methods, prefs
// ─────────────────────────────────────────────────────────────────────────

model Address {
  id           String   @id @default(cuid())
  userId       String
  label        String? // Home, Work
  recipient    String
  phone        String
  cityId       String
  district     String?
  street       String
  building     String?
  apartment    String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  instructions String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  city          City           @relation(fields: [cityId], references: [id])
  orders        Order[]
  subscriptions Subscription[]

  @@index([userId])
  // Community city filter joins Cat→user→addresses(cityId) on the default addr.
  @@index([cityId, isDefault])
  @@map("addresses")
}

model PaymentMethod {
  id         String          @id @default(cuid())
  userId     String
  provider   PaymentProvider
  token      String // tokenized reference from PSP — never raw PAN
  brand      String? // visa/mada/mastercard
  last4      String?
  expMonth   Int?
  expYear    Int?
  holderName String?
  isDefault  Boolean         @default(false)
  createdAt  DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId])
  @@map("payment_methods")
}

model NotificationPreference {
  id       String               @id @default(cuid())
  userId   String
  channel  NotificationChannel
  category NotificationCategory
  enabled  Boolean              @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────────────
//  CATS
// ─────────────────────────────────────────────────────────────────────────

model Breed {
  id           String  @id @default(cuid())
  nameEn       String  @unique
  nameAr       String
  avgWeightKg  Float?
  caloriePerKg Float? // kcal/day per kg reference, feeds the engine
  description  String?

  cats Cat[]

  @@map("breeds")
}

model Cat {
  id             String        @id @default(cuid())
  userId         String
  /// The Cat ID — a unique, human-readable membership number (R032).
  /// The soul of the product: issued with ceremony, never a silent DB row.
  catIdNumber    String?       @unique
  idIssuedAt     DateTime?
  /// Opaque, revocable QR verification token (NOT a public URL). Scanned only by
  /// the Moracat app / authorized partners to check identity + membership (R057).
  qrToken        String?       @unique
  name           String
  /// Search-normalized copy of `name` (Arabic diacritics/tatweel stripped, alef
  /// & yaa unified, lowercased). Maintained on write so community search matches
  /// across spelling variants — Arabic is the default experience (R101).
  nameNormalized String?
  photoUrl       String?
  breedId        String?
  gender         CatGender     @default(UNKNOWN)
  birthDate      DateTime?
  weightKg       Float?
  lifeStage      LifeStage?
  activityLevel  ActivityLevel @default(MODERATE)
  isIndoor       Boolean       @default(true)
  diet           String?
  vetNotes       String?
  microchipNo    String?
  favoriteFoods  String[]
  preferredBrand String[]
  // Full-registration profile (#3) — collected before the Cat ID is issued.
  coatColor          String?
  isNeutered         Boolean?
  vaccinationStatus  String? // UP_TO_DATE / PARTIAL / NONE / UNKNOWN
  currentMedications String?
  emergencyNotes     String?
  /// The cat's *character & keepsake* layer — everything the fast Cat-ID issue
  /// deliberately postpones (R002/R016): personality, favourites, playful "fun"
  /// answers, and the owner's card personalisation (theme, accent, stickers,
  /// frame). A single JSON blob keeps the schema calm while the invited
  /// "complete the file" journey grows; it is owner-authored, server-sanitised
  /// (shape + size capped in CatsService), and never gates membership or safety.
  profile            Json?
  /// Household lifecycle. A cat is never silently dropped: removal soft-deletes,
  /// and a passing is archived as DECEASED so the record and Cat ID endure.
  status           CatStatus           @default(ACTIVE)
  // Membership is INACTIVE until a subscription activates it (R#9). The Cat ID is
  // still issued immediately; only the membership benefits gate on payment.
  // In Community Mode every Cat ID stays INACTIVE ("Coming Soon") — activation
  // is impossible until payments go live.
  membershipStatus CatMembershipStatus @default(INACTIVE)
  archivedAt       DateTime?
  deceasedAt       DateTime?

  // ── Community & sharing (all opt-in; private by default) ────────────────
  /// Whether this cat appears in the public community. Always false until the
  /// owner explicitly chooses to share. Post-moderation: visible immediately,
  /// admins can hide.
  isPublic       Boolean   @default(false)
  /// Stable, human-friendly handle for the public share URL (/community/:slug).
  publicSlug     String?   @unique
  bio            String?
  coverUrl       String?
  sharedAt       DateTime?
  /// PDPL photo-consent attestation (R106): stamped server-side the first time
  /// the owner confirms that any people visible in the cat's photos agreed to
  /// their publication. Null = never attested → the web asks once, before the
  /// profile first goes public. Never written from a client-supplied timestamp.
  shareConsentAt DateTime?
  viewCount      Int       @default(0)
  /// Denormalized like tally — kept in lock-step with the CatLike rows via an
  /// atomic increment/decrement so "Most Loved" sorts on an index, not a count().
  likeCount      Int       @default(0)
  isFeatured     Boolean   @default(false)
  featuredAt     DateTime?
  /// Moderation: set when an admin hides a public cat. Non-null = not shown.
  hiddenAt       DateTime?
  hiddenReason   String?
  // Per-field privacy — the owner controls exactly what a public visitor sees.
  showOwnerName  Boolean   @default(false)
  showCity       Boolean   @default(false)
  showGallery    Boolean   @default(true)
  showAge        Boolean   @default(true)
  showBreed      Boolean   @default(true)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  primaryOfUser   User?                   @relation("PrimaryCat")
  breed           Breed?                  @relation(fields: [breedId], references: [id])
  healthConds     CatHealthCondition[]
  allergies       CatAllergy[]
  vaccinations    CatVaccination[]
  vetVisits       CatVetVisit[]
  documents       CatDocument[]
  recommendations FeedingRecommendation[]
  subscriptions   SubscriptionCat[]
  photos          CatPhoto[]
  likes           CatLike[]
  reports         CatReport[]
  // ── Veterinary platform (MRC-VET-001) ──────────────────────────────────
  visits            Visit[]
  clinicalEntries   ClinicalEntry[]
  prescriptions     Prescription[]
  weightRecords     CatWeightRecord[]
  consentGrants     ConsentGrant[]
  recordAccessLogs  RecordAccessLog[]
  emergencyContacts CatEmergencyContact[]

  @@index([userId])
  @@index([userId, status])
  // Community browse: public + not hidden, ordered by recency / popularity /
  // featured. Partial-index-friendly composite keys.
  @@index([isPublic, hiddenAt, sharedAt])
  @@index([isPublic, hiddenAt, viewCount])
  @@index([isPublic, hiddenAt, likeCount])
  @@index([isPublic, isFeatured])
  @@index([nameNormalized])
  @@map("cats")
}

/// A member's "love" for a public cat. One row per (user, cat) — the unique
/// constraint makes the like idempotent, and Cat.likeCount is the denormalized
/// tally kept in step with these rows inside a transaction.
model CatLike {
  id        String   @id @default(cuid())
  userId    String
  catId     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  cat  Cat  @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@unique([userId, catId])
  @@index([catId])
  @@index([userId])
  @@map("cat_likes")
}

/// A member's report of a public cat — the primary moderation signal at scale.
/// Reactive browse-and-hide doesn't scale, so reports feed a queue admins work
/// (sort by pending + age). One member may only report a given cat once.
model CatReport {
  id           String          @id @default(cuid())
  catId        String
  reporterId   String? // nullable so an anonymized reporter (post-deletion) survives
  reason       CatReportReason
  detail       String?
  status       ReportStatus    @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  resolution   String? // "hidden" / "dismissed" + optional note
  createdAt    DateTime        @default(now())

  cat        Cat   @relation(fields: [catId], references: [id], onDelete: Cascade)
  reporter   User? @relation("CatReportReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  resolvedBy User? @relation("CatReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  // One report per member per cat — dedupes brigading into a single signal.
  @@unique([catId, reporterId])
  // The moderation queue: pending first, oldest first.
  @@index([status, createdAt])
  @@index([catId])
  @@map("cat_reports")
}

enum CatReportReason {
  INAPPROPRIATE
  SPAM
  FAKE
  HARASSMENT
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

/// A gallery photo for a cat (profile shots beyond the primary `photoUrl`).
/// Stored in object storage (Cloudflare R2 / S3-compatible); `url` is the
/// public/CDN URL, never a local path.
model CatPhoto {
  id        String   @id @default(cuid())
  catId     String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId, sortOrder])
  @@map("cat_photos")
}

/// A single vaccination event — part of every cat's health record.
model CatVaccination {
  id             String    @id @default(cuid())
  catId          String
  name           String // "Tricat", "Rabies", ...
  administeredAt DateTime
  dueAt          DateTime? // next dose reminder
  vetName        String?
  clinic         String?
  batchNo        String?
  notes          String?
  createdAt      DateTime  @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId, administeredAt])
  @@map("cat_vaccinations")
}

/// A vet visit in the cat's history.
model CatVetVisit {
  id        String   @id @default(cuid())
  catId     String
  visitedAt DateTime
  reason    String
  clinic    String?
  vetName   String?
  diagnosis String?
  notes     String?
  weightKg  Float?
  cost      Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId, visitedAt])
  @@map("cat_vet_visits")
}

/// A document attached to a cat (adoption papers, pedigree, lab results, ...).
model CatDocument {
