  catId     String
  title     String
  kind      String // adoption, pedigree, lab, insurance, other
  url       String
  notes     String?
  createdAt DateTime @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
  @@map("cat_documents")
}

model CatHealthCondition {
  id    String  @id @default(cuid())
  catId String
  name  String
  notes String?

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
  @@map("cat_health_conditions")
}

model CatAllergy {
  id       String @id @default(cuid())
  catId    String
  allergen String

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId])
  @@map("cat_allergies")
}

// ─────────────────────────────────────────────────────────────────────────
//  SMART FEEDING ENGINE — persisted recommendations
// ─────────────────────────────────────────────────────────────────────────

model FeedingRecommendation {
  id               String   @id @default(cuid())
  catId            String
  dryFoodKgMonth   Float
  wetPouchesMonth  Int
  treatsPacksMonth Int
  litterKgMonth    Float
  supplementsMonth Int
  dailyCalories    Float
  estimatedCost    Decimal  @db.Decimal(10, 2)
  confidence       Float // 0..1
  rationale        Json // inputs + guideline references for transparency
  createdAt        DateTime @default(now())

  cat Cat @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@index([catId, createdAt])
  @@map("feeding_recommendations")
}

// ─────────────────────────────────────────────────────────────────────────
//  CATALOG — brands, categories, products
// ─────────────────────────────────────────────────────────────────────────

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  nameEn      String
  nameAr      String
  logoUrl     String?
  description String?
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())

  products Product[]

  @@map("brands")
}

model Category {
  id        String  @id @default(cuid())
  slug      String  @unique
  nameEn    String
  nameAr    String
  parentId  String?
  imageUrl  String?
  sortOrder Int     @default(0)

  parent   Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[]        @relation("CategoryTree")
  products ProductCategory[]

  @@map("categories")
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  sku            String      @unique
  barcode        String?     @unique
  type           ProductType
  brandId        String?
  nameEn         String
  nameAr         String
  descriptionEn  String?     @db.Text
  descriptionAr  String?     @db.Text
  price          Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal?    @db.Decimal(10, 2)
  costPrice      Decimal?    @db.Decimal(10, 2)
  currency       String      @default("SAR")
  weightGrams    Int?
  ratingAvg      Float       @default(0)
  ratingCount    Int         @default(0)
  isActive       Boolean     @default(true)
  isSubscribable Boolean     @default(true)
  // ── Catalog / merchandising flags (2026-07 supplier import) ──────────────
  /// Surfaced in the public store. Store is not yet public — imported products
  /// stay isStorePublished=false until the storefront launches.
  isStorePublished Boolean   @default(false)
  isFeatured     Boolean     @default(false)
  /// Not eligible inside subscription boxes (store-only merchandise).
  isStoreOnly    Boolean     @default(false)
  /// Only offered to Premium-tier members / boxes.
  isPremiumOnly  Boolean     @default(false)
  /// Space-separated search keywords (name/brand/variant), ar+en, for lookup.
  searchKeywords String?     @db.Text
  /// Flavor / variant label the member chooses in the box builder (e.g.
  /// "Chicken", "Salmon & Tuna"). Null for non-food or single-variant items.
  flavorEn       String?
  flavorAr       String?
  /// Fulfilment status for box-builder options: IN_STOCK (imported supplier
  /// catalog) vs TO_SOURCE (popular option we advertise but must procure).
  sourcing       SourcingStatus @default(IN_STOCK)
  /// Per-product low-stock alert threshold (0 = use warehouse reorderLevel).
  lowStockThreshold Int      @default(0)
  /// Original supplier image reference (screenshot filename) — NOT shown to
  /// customers; kept so official manufacturer images can replace it later.
  supplierImageRef String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  brand          Brand?              @relation(fields: [brandId], references: [id])
  categories     ProductCategory[]
  images         ProductImage[]
  videos         ProductVideo[]
  variants       ProductVariant[]
  ingredients    ProductIngredient[]
  nutrition      NutritionFact[]
  reviews        ProductReview[]
  questions      ProductQuestion[]
  tags           ProductTag[]
  relatedFrom    RelatedProduct[]    @relation("RelatedFrom")
  relatedTo      RelatedProduct[]    @relation("RelatedTo")
  inventoryItems InventoryItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  subItems       SubscriptionItem[]
  wishlistItems  WishlistItem[]
  recentlyViewed RecentlyViewed[]
  planContents   PlanContent[]

  @@index([type])
  @@index([brandId])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  sku         String   @unique
  nameEn      String // "2kg", "5kg"
  nameAr      String
  price       Decimal  @db.Decimal(10, 2)
  weightGrams Int?
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int     @default(0)
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id        String  @id @default(cuid())
  productId String
  url       String
  title     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model Ingredient {
  id     String @id @default(cuid())
  nameEn String @unique
  nameAr String

  products ProductIngredient[]

  @@map("ingredients")
}

model ProductIngredient {
  productId    String
  ingredientId String
  sortOrder    Int    @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

model NutritionFact {
  id        String @id @default(cuid())
  productId String
  label     String // "Crude Protein", "Moisture"
  value     String // "32%"
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("nutrition_facts")
}

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameEn String
  nameAr String

  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String
  tagId     String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model RelatedProduct {
  productId String
  relatedId String

  product Product @relation("RelatedFrom", fields: [productId], references: [id], onDelete: Cascade)
  related Product @relation("RelatedTo", fields: [relatedId], references: [id], onDelete: Cascade)

  @@id([productId, relatedId])
  @@map("related_products")
}

model ProductReview {
  id         String   @id @default(cuid())
  productId  String
  userId     String
  rating     Int // 1..5
  title      String?
  body       String?  @db.Text
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_reviews")
}

model ProductQuestion {
  id         String    @id @default(cuid())
  productId  String
  userId     String
  question   String
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_questions")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@map("recently_viewed")
}

// ─────────────────────────────────────────────────────────────────────────
//  SUBSCRIPTION ENGINE — plans + built subscriptions
// ─────────────────────────────────────────────────────────────────────────

model Plan {
  id            String   @id @default(cuid())
  tier          PlanTier @unique
  slug          String   @unique
  nameEn        String
  nameAr        String
  descriptionEn String?
  descriptionAr String?
  basePrice     Decimal  @db.Decimal(10, 2) // monthly price, from financial model
  cogs          Decimal  @db.Decimal(10, 2)
  currency      String   @default("SAR")
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  /// Minimum committed subscription length in months (KSA policy: 3-month minimum).
  minTermMonths Int      @default(3)

  contents      PlanContent[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlanContent {
  id        String  @id @default(cuid())
  planId    String
  productId String?
  label     String // "Dry food — premium (kg)"
  quantity  Float
  unit      String // kg, pouch, pack, each
  /// When set, this box line is CHOOSABLE: the member picks any subscribable
  /// product of this type (brand + flavor) in the box builder, and `productId`
  /// is the recommended default. Null = fixed line (no choice offered).
  selectableType ProductType?

  plan       Plan               @relation(fields: [planId], references: [id], onDelete: Cascade)
  product    Product?           @relation(fields: [productId], references: [id])
  selections SubscriptionItem[]

  @@index([planId])
  @@map("plan_contents")
}

model Subscription {
  id             String             @id @default(cuid())
  userId         String
  planId         String?
  addressId      String?
  status         SubscriptionStatus @default(DRAFT)
  interval       BillingInterval    @default(MONTHLY)
  intervalDays   Int? // for CUSTOM
  price          Decimal            @db.Decimal(10, 2) // monthly price snapshot
  currency       String             @default("SAR")
  /// Committed term in months (>= plan.minTermMonths, default 3). The member
  /// pays price*termMonths upfront (Tamara), delivered monthly across the term.
  termMonths     Int                @default(3)
  /// When the committed term ends — renewal/next-charge is due at this date.
  endsAt         DateTime?
  isGift         Boolean            @default(false)
  giftRecipient  String?
  startedAt      DateTime?
  nextBillingAt  DateTime?
  nextDeliveryAt DateTime?
  pausedUntil    DateTime?
  /// When the current pause began. resume() extends endsAt / delivery dates by
  /// the paused duration so paid months are never lost (R062).
  pausedAt       DateTime?
  /// Honest cancel (R063): the member chose not to renew. The prepaid term keeps
  /// servicing until endsAt; the lifecycle job lapses it then — cancel never
  /// confiscates a paid term.
  cancelAtTermEnd Boolean           @default(false)
  cancelledAt    DateTime?
  vacationMode   Boolean            @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user    User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan    Plan?               @relation(fields: [planId], references: [id])
  address Address?            @relation(fields: [addressId], references: [id])
  items   SubscriptionItem[]
  cats    SubscriptionCat[]
  events  SubscriptionEvent[]
  orders  Order[]

  @@index([userId])
  @@index([status])
  @@index([nextBillingAt])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String  @id @default(cuid())
  subscriptionId String
  productId      String
  quantity       Int     @default(1)
  unitPrice      Decimal @db.Decimal(10, 2)
  isOneTime      Boolean @default(false)
  /// The box line this choice fulfils (brand/flavor pick). Null for legacy /
  /// à-la-carte items. Flat pricing: unitPrice is 0 for a plan-line selection —
  /// the plan price already covers it; this row records the member's preference.
  planContentId  String?

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id])
  planContent  PlanContent? @relation(fields: [planContentId], references: [id])

  @@index([subscriptionId])
  @@map("subscription_items")
}

model SubscriptionCat {
  subscriptionId String
  catId          String

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  cat          Cat          @relation(fields: [catId], references: [id], onDelete: Cascade)

  @@id([subscriptionId, catId])
  @@map("subscription_cats")
}

model SubscriptionEvent {
  id             String   @id @default(cuid())
  subscriptionId String
  type           String // paused, resumed, skipped, plan_changed, ...
  metadata       Json?
  createdAt      DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

// ─────────────────────────────────────────────────────────────────────────
//  COMMERCE — cart, orders, payments, invoices, discounts
// ─────────────────────────────────────────────────────────────────────────

model Cart {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String? // guest carts
  currency  String   @default("SAR")
  couponId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int     @default(1)
  unitPrice Decimal @db.Decimal(10, 2)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(cuid())
  orderNumber    String      @unique
  userId         String
  subscriptionId String?
  addressId      String?
  source         OrderSource @default(ONE_TIME)
  status         OrderStatus @default(PENDING)
  subtotal       Decimal     @db.Decimal(10, 2)
  discountTotal  Decimal     @default(0) @db.Decimal(10, 2)
  shippingTotal  Decimal     @default(0) @db.Decimal(10, 2)
  taxTotal       Decimal     @default(0) @db.Decimal(10, 2)
  grandTotal     Decimal     @db.Decimal(10, 2)
  currency       String      @default("SAR")
  couponCode     String?
  placedAt       DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User            @relation(fields: [userId], references: [id])
  subscription Subscription?   @relation(fields: [subscriptionId], references: [id])
  address      Address?        @relation(fields: [addressId], references: [id])
  items        OrderItem[]
  payments     Payment[]
  invoice      Invoice?
  shipment     Shipment?
  returns      ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  nameEn    String
  nameAr    String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id              String          @id @default(cuid())
  orderId         String
  paymentMethodId String?
  provider        PaymentProvider
  status          PaymentStatus   @default(PENDING)
  amount          Decimal         @db.Decimal(10, 2)
  currency        String          @default("SAR")
  providerRef     String? // PSP transaction id
  failureReason   String?
  /// Provider session context — e.g. the hosted checkout URL for a redirect
  /// flow, persisted so a DRAFT membership can resume payment (never a dead end).
  metadata        Json?
  capturedAt      DateTime?
  createdAt       DateTime        @default(now())

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  refunds       Refund[]

  @@index([orderId])
  @@map("payments")
}

model Refund {
  id          String   @id @default(cuid())
  paymentId   String
  amount      Decimal  @db.Decimal(10, 2)
  reason      String?
  providerRef String?
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  orderId       String        @unique
  userId        String
  status        InvoiceStatus @default(ISSUED)
  subtotal      Decimal       @db.Decimal(10, 2)
  taxTotal      Decimal       @db.Decimal(10, 2)
  grandTotal    Decimal       @db.Decimal(10, 2)
  vatNumber     String?
  issuedAt      DateTime      @default(now())
  paidAt        DateTime?
  pdfUrl        String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("invoices")
}

model Coupon {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minSubtotal    Decimal?     @db.Decimal(10, 2)
  maxRedemptions Int?
  redeemedCount  Int          @default(0)
  perUserLimit   Int?
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@map("coupons")
}

model GiftCard {
  id             String    @id @default(cuid())
  code           String    @unique
  initialBalance Decimal   @db.Decimal(10, 2)
  balance        Decimal   @db.Decimal(10, 2)
  currency       String    @default("SAR")
  issuedToId     String?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@map("gift_cards")
}

// ─────────────────────────────────────────────────────────────────────────
//  WALLET & LOYALTY
// ─────────────────────────────────────────────────────────────────────────

model Wallet {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("SAR")
  createdAt DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id           String        @id @default(cuid())
  walletId     String
  type         WalletTxnType
  amount       Decimal       @db.Decimal(10, 2)
  balanceAfter Decimal       @db.Decimal(10, 2)
  reference    String?
  description  String?
  createdAt    DateTime      @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model LoyaltyAccount {
  id        String      @id @default(cuid())
  userId    String      @unique
  points    Int         @default(0)
  tier      LoyaltyTier @default(BRONZE)
  createdAt DateTime    @default(now())

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  accountId String
  points    Int // +earn / -redeem
  reason    String
  createdAt DateTime @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

model Badge {
  id          String  @id @default(cuid())
  key         String  @unique
  nameEn      String
  nameAr      String
  iconUrl     String?
  description String?

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referredId  String?  @unique
  code        String   @unique
  email       String?
  rewardGiven Boolean  @default(false)
  createdAt   DateTime @default(now())

  referrer User  @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("Referred", fields: [referredId], references: [id])

  @@index([referrerId])
  @@map("referrals")
}

// ─────────────────────────────────────────────────────────────────────────
//  DELIVERY — cities, zones, shipments, drivers
// ─────────────────────────────────────────────────────────────────────────

model City {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameEn   String
  nameAr   String
  isActive Boolean @default(true)

  zones        DeliveryZone[]
  addresses    Address[]
  branches     Branch[]
  applications PartnerApplication[]

  @@map("cities")
}

model DeliveryZone {
  id       String  @id @default(cuid())
  cityId   String
  nameEn   String
  nameAr   String
  fee      Decimal @default(0) @db.Decimal(10, 2)
  isActive Boolean @default(true)

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@index([cityId])
  @@map("delivery_zones")
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  shipments Shipment[]

  @@map("drivers")
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  driverId       String?
  status         ShipmentStatus @default(LABEL_CREATED)
  trackingNumber String?        @unique
  carrier        String?
  estimatedAt    DateTime?
  deliveredAt    DateTime?
  currentLat     Float?
  currentLng     Float?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver Driver?         @relation(fields: [driverId], references: [id])
  events ShipmentEvent[]

  @@map("shipments")
}

model ShipmentEvent {
  id         String         @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  note       String?
  lat        Float?
  lng        Float?
  createdAt  DateTime       @default(now())

