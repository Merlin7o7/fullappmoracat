{
  "name": "@moraqat/db",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "push": "prisma db push",
    "seed": "tsx prisma/seed.ts",
    "seed:community": "tsx prisma/seed-community.ts",
    "backfill:community-share": "tsx prisma/backfill-community-share.ts",
    "seed:catalog": "tsx prisma/seed-catalog.ts",
    "local": "node scripts/pg-local.mjs",
    "studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "seed:vet-demo": "tsx prisma/seed-vet-demo.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^3.0.3",
    "prisma": "^5.20.0",
    "@moraqat/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20.16.10",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.23.12",
    "typescript": "^5.6.2"
  }
}
